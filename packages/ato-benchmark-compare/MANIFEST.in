# Preserve the source distribution shipped by the previous backend.
include NOTICE
include CONTRIBUTING.md LIMITATIONS.md SECURITY.md .gitignore LICENSE README.md
# The component's own lock, so the shipped tests run in its locked environment.
include uv.lock
graft atobenchmark
graft docs
graft examples
graft tests
# The fast-check worker for the property tests; npm installs node_modules.
prune tests/fastcheck/node_modules
graft tools
global-exclude *.py[cod]
